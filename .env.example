# TerraShield AI - Environment Configuration Example
# Copy this file to .env and populate with your own credentials if available.
# The application functions seamlessly in HISTORICAL_SAMPLE and DEMO modes without external keys.

# NASA FIRMS API Credentials (https://firms.modaps.eosdis.nasa.gov/api/map_key)
# Required for LIVE satellite hotspot queries from NASA satellites (VIIRS / MODIS).
FIRMS_MAP_KEY=your_firms_map_key_here

# TinyFish API Credentials (https://www.tinyfish.ai/)
# Required for LIVE web search and public wildfire advisory fetch.
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Groq Cloud API Credentials (https://console.groq.com/keys)
# Required for GPT-OSS-powered source-grounded incident explanation & dossier synthesis.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# CARTO Map API Credentials (https://carto.com/basemaps/apikey)
# Appended as '?key=' to raster tile requests. Public client-side basemap key.
CARTO_API_KEY=
VITE_CARTO_API_KEY=
# Alternative alias: CARTO_MAP_KEY=

# Application Configuration
APP_ENV=development
DATA_MODE=HISTORICAL_SAMPLE
DEFAULT_REGION=INDIA_ALL
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Verification Engine Thresholds
MAX_CORROBORATION_DISTANCE_KM=35.0
MAX_TEMPORAL_DELTA_HOURS=72.0
MIN_INDEPENDENT_SOURCES_FOR_CORROBORATION=2
